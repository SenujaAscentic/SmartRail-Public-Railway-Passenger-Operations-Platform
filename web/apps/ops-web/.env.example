# Copy this file to .env.local (which git ignores) and set the value. Development only.
#
# The id of the Main Line, which the live page needs to ask the stream for its events (lineIds).
# It goes away when the backend has GET /lines. Until then, read it from your database after the backend has started once:
#   SELECT "Id" FROM network."Lines";
VITE_MAIN_LINE_ID=
