{
  "name": "@smartrail/ops-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SmartRail operations web app (staff only, signed in). ADR-06.",
  "scripts": {
    "tokens": "node ../../packages/tokens/scripts/build-tokens.ts",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "tsc -p . && vite build",
    "pretypecheck": "npm run tokens",
    "typecheck": "tsc -p .",
    "pretest": "npm run tokens",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@microsoft/fetch-event-source": "2.0.1",
    "@smartrail/api-client": "0.0.0",
    "@smartrail/tokens": "0.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  }
}
