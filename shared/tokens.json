{
  "$schema": "SmartRail design tokens v1 (12 Oct 2026). One source for web (CSS variables) and Flutter (Dart constants). Status is never shown by colour alone: every status has text and an icon.",
  "color": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#F4F6F8",
      "text": "#14202B",
      "textMuted": "#4A5560",
      "border": "#C9D1D9",
      "accent": "#1D5FA8",
      "focus": "#1D5FA8"
    },
    "dark": {
      "background": "#0B1A2B",
      "surface": "#13263B",
      "text": "#FFFFFF",
      "textMuted": "#B8C4D0",
      "border": "#2C4258",
      "accent": "#7DB7FF",
      "focus": "#FFD24D"
    }
  },
  "status": {
    "OnTime":          { "icon": "check-circle",   "light": { "fg": "#1B6E35", "bg": "#E3F4E8" }, "dark": { "fg": "#6EE7A0", "bg": "#123824" } },
    "Early":           { "icon": "arrow-up-left",  "light": { "fg": "#1D5FA8", "bg": "#E3EEFA" }, "dark": { "fg": "#8CC4FF", "bg": "#12304F" } },
    "Late":            { "icon": "clock-alert",    "light": { "fg": "#8A4B00", "bg": "#FCEFD9" }, "dark": { "fg": "#FFC266", "bg": "#3D2A0B" } },
    "Held":            { "icon": "hand-stop",      "light": { "fg": "#8A4B00", "bg": "#FCEFD9" }, "dark": { "fg": "#FFC266", "bg": "#3D2A0B" } },
    "Cancelled":       { "icon": "x-circle",       "light": { "fg": "#A8201A", "bg": "#FBE4E2" }, "dark": { "fg": "#FF8A80", "bg": "#4A1512" } },
    "TerminatedEarly": { "icon": "x-circle",       "light": { "fg": "#A8201A", "bg": "#FBE4E2" }, "dark": { "fg": "#FF8A80", "bg": "#4A1512" } },
    "PlatformChanged": { "icon": "arrows-exchange","light": { "fg": "#14202B", "bg": "#FFE27A" }, "dark": { "fg": "#0B1A2B", "bg": "#FFD24D" } },
    "NotStarted":      { "icon": "clock",          "light": { "fg": "#4A5560", "bg": "#EEF1F4" }, "dark": { "fg": "#B8C4D0", "bg": "#1C2F44" } },
    "Scheduled":       { "icon": "calendar",       "light": { "fg": "#4A5560", "bg": "#EEF1F4" }, "dark": { "fg": "#B8C4D0", "bg": "#1C2F44" } },
    "Stale":           { "icon": "signal-weak",    "light": { "fg": "#8A4B00", "bg": "#FCEFD9" }, "dark": { "fg": "#FFC266", "bg": "#3D2A0B" } },
    "Lost":            { "icon": "signal-off",     "light": { "fg": "#4A5560", "bg": "#EEF1F4" }, "dark": { "fg": "#B8C4D0", "bg": "#1C2F44" } }
  },
  "typography": {
    "fontFamily": "Noto Sans (supports Sinhala and Tamil later)",
    "fontFamilyMono": "Noto Sans Mono (times, platform numbers)",
    "numerals": "tabular",
    "surfaces": {
      "passenger": { "body": 16, "small": 14, "title": 22, "time": 28, "platform": 28 },
      "ops":       { "body": 14, "small": 12, "title": 18, "time": 14, "platform": 14 },
      "crew":      { "body": 22, "small": 18, "title": 28, "time": 48, "platform": 40 },
      "display":   { "body": 48, "small": 36, "title": 64, "time": 72, "platform": 88, "note": "px at 1920×1080 on a ≥ 55-inch screen; verify readability at 10 m (US-D1) on the demo screen" }
    }
  },
  "space": { "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 32 },
  "radius": { "sm": 4, "md": 8, "lg": 12 },
  "touchTarget": { "passenger": 48, "ops": 32, "crew": 64 },
  "motion": { "durationMs": 150, "respectReducedMotion": true },
  "rules": [
    "Contrast: WCAG 2.2 AA (4.5:1 for text, 3:1 for large text and icons) in both themes.",
    "Status = icon + text + colour; never colour alone (Q-4).",
    "Crew app and station displays use the dark theme; passenger app and ops web follow the system setting.",
    "Times use tabular numerals so columns do not shift when digits change."
  ]
}
