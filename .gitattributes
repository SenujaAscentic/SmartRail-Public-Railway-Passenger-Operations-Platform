# Text files are stored with LF in the repository and checked out as LF on every machine (Windows included).
* text=auto eol=lf

# Binary files: never touched by line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.pdf binary
