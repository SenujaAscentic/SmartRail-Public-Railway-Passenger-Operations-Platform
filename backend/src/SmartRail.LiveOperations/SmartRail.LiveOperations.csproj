<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Part of the SDK, not a package: gives the module the hosting types (background service, endpoints). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartRail.LiveOperations.Domain\SmartRail.LiveOperations.Domain.csproj" />
    <ProjectReference Include="..\SmartRail.Network\SmartRail.Network.csproj" />
    <!-- Only Identity's public IStaffDirectory is used (to find a driver's account id); allowed since 18 Oct (architecture test). -->
    <ProjectReference Include="..\SmartRail.Identity\SmartRail.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the module's internal outbox and stream types, like Network and Identity do. -->
    <InternalsVisibleTo Include="SmartRail.UnitTests" />
    <InternalsVisibleTo Include="SmartRail.IntegrationTests" />
  </ItemGroup>

</Project>
